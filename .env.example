# Copy to .env and fill in the values needed by the services you enable.
# No code in this repo carries default hosts, ports, credentials or data.

# Postgres (authoritative store) — also used by docker-compose
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=postgres://<user>:<password>@localhost:<port>/<db>

# Neo4j (knowledge-graph projection) — also used by docker-compose
NEO4J_URI=bolt://localhost:<port>
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_BOLT_PORT=
NEO4J_HTTP_PORT=

# API
API_PORT=
WEB_ORIGIN=
# Optional explicit additional clients, comma-separated; packaged Tauri origins are platform-specific.
# WEB_ADDITIONAL_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
LOG_LEVEL=info
# Content-addressed blob storage for source/artifact content (never sent in events)
BLOB_DIR=
# Developer-console operators: comma-separated user_<id>:<token> pairs (token ≥ 24 chars)
OPERATOR_TOKENS=
# Recovery approvals expire after this many seconds
APPROVAL_TTL_SECONDS=
# Arena
ROOM_TTL_SECONDS=
ARENA_BRIEFING_SECONDS=
ARENA_ATTACK_WINDOW_SECONDS=
# Offline seconds before a defender's QUARANTINE/APPROVE cards move to a connected defender
ARENA_RECONNECT_GRACE_SECONDS=
# Expired-room sweep interval (seconds)
ARENA_SWEEP_SECONDS=
# Per-minute limits: joins per IP, card actions per player token
ARENA_JOIN_RATE_PER_MINUTE=
ARENA_ACTION_RATE_PER_MINUTE=

# Agent runtime: "enabled" (requires provider auth, sandbox and scheduler configuration below) or "disabled" (data only)
AGENT_RUNTIME=

# Workflow CLI (pnpm workflow:submit / workflow:project) — one of the OPERATOR_TOKENS
API_URL=
OPERATOR_TOKEN=

# Optional: run the live Neo4j integration test (pnpm test)
# NEO4J_TEST_URI=
# NEO4J_TEST_USER=
# NEO4J_TEST_PASSWORD=

# Web (Vite)
VITE_API_URL=

# LLM provider keys live server-side only (used by runtime-pi). Never expose to the browser.
# ANTHROPIC_API_KEY=

# Person 2: Pi runtime and scheduler (required by their factories)
PI_PROVIDER=
PI_MODEL=
PI_BASE_URL=
# Optional metadata for a model absent from Pi's installed registry (api-key mode only).
# JSON fields: api (openai-completions), reasoning (boolean), input (text/image array),
# contextWindow, maxTokens, cost (input/output/cacheRead/cacheWrite per million tokens).
# Use the provider's published limits and pricing. No automatic fallback is configured.
PI_CUSTOM_MODEL_JSON=
# api-key for OpenRouter/Claude API; oauth for Codex ChatGPT login
PI_AUTH_MODE=
PI_API_KEY=
# Required only for oauth: absolute path to the credentials written by pnpm agent:login
PI_AUTH_FILE=
PI_AGENT_DIR=
PI_TIMEOUT_MS=
# Optional private prompt/tool/token traces; required for documented B2 experiments.
# PI_TRACE_DIRECTORY=
SCHEDULER_PARALLELISM=
# Seconds a REQUIRE_APPROVAL tool call waits for an operator before it expires
TOOL_APPROVAL_TTL_SECONDS=

# Isolated tool worker; all mounts, images, destinations and limits are configured.
SANDBOX_NODE_IMAGE=
SANDBOX_URL=
SANDBOX_TOKEN=
SANDBOX_ROOT=
SANDBOX_WORKSPACE_PATH=
SANDBOX_AUDIT_PATH=
SANDBOX_AUDIT_DIRECTORY=
SANDBOX_AUDIT_MOUNT=
SANDBOX_HTTP_ORIGINS=
SANDBOX_EXEC_COMMANDS=
SANDBOX_TOOL_OPERATIONS=
SANDBOX_TIMEOUT_MS=
SANDBOX_MAX_BYTES=
SANDBOX_PORT=
SANDBOX_BIND_HOST=
SANDBOX_PUBLISH_HOST=
SANDBOX_PUBLISH_PORT=
SANDBOX_PIDS_LIMIT=
SANDBOX_MEMORY_LIMIT=
SANDBOX_CPUS=

# Optional internal target service (sandbox/target-compose.yml)
# SANDBOX_TARGET_HOST=
# SANDBOX_TARGET_ROOT=
# SANDBOX_TARGET_PORT=
# SANDBOX_TARGET_BIND_HOST=
# SANDBOX_TARGET_MAX_BYTES=
# SANDBOX_TARGET_CONTENT_DIRECTORY=
# SANDBOX_TARGET_AUDIT_DIRECTORY=
# SANDBOX_TARGET_AUDIT_MOUNT=
# SANDBOX_TARGET_AUDIT_PATH=

# Optional real Docker acceptance test: SANDBOX_DOCKER_TEST=enabled
# Real model comparison runner (sandbox/model-runs.mjs)
# Uses API_URL and OPERATOR_TOKEN from the workflow CLI configuration above.
# EXPERIMENT_WORKFLOW_ID=
# EXPERIMENT_REPETITIONS=
# EXPERIMENT_TIMEOUT_MS=
# EXPERIMENT_POLL_MS=
# EXPERIMENT_EVENT_PAGE_SIZE=
# EXPERIMENT_OUTPUT_PATH=

# Optional repository connector: absolute path to installed Git; omit to disable.
# Tracked source bytes must fit SANDBOX_MAX_BYTES. Repositories must be mounted inside the sandbox.
# REPOSITORY_GIT_EXECUTABLE=

# Encrypted per-operator provider connections. Generate 32 random bytes as hex; keep outside Git.
# Back up this key separately from Postgres. Losing it requires reconnecting every provider.
# PROVIDER_CREDENTIAL_KEY=
# Optional local ChatGPT sign-in configuration, JSON object (see docs/CONNECTIONS.md).
# CHATGPT_OAUTH_CONFIG=

# Required for ChatGPT account models not bundled with Pi. JSON with api=openai-responses,
# reasoning, input, contextWindow, maxTokens, and cost (input/output/cacheRead/cacheWrite).
# These are operator runtime budgets/accounting settings, not provider-advertised model specifications.
CHATGPT_MODEL_CONFIG=
