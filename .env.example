# Postgres (authoritative store)
DATABASE_URL=postgres://splitbrain:splitbrain@localhost:5432/splitbrain

# Neo4j (knowledge-graph projection)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=splitbrain-dev

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Web (Vite) – "mock" replays packages/contracts/fixtures/demo-run.events.json, "live" uses the API
VITE_API_URL=http://localhost:4000
VITE_STREAM_MODE=mock

# LLM provider keys live server-side only (used by runtime-pi). Never expose to the browser.
# ANTHROPIC_API_KEY=
