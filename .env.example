# Copy to .env and fill in. Every value is required: the apps refuse to start without them.
# No code in this repo carries default hosts, ports, credentials or data.

# Postgres (authoritative store) — also used by docker-compose
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=postgres://<user>:<password>@localhost:<port>/<db>

# Neo4j (knowledge-graph projection) — also used by docker-compose
NEO4J_URI=bolt://localhost:<port>
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_BOLT_PORT=
NEO4J_HTTP_PORT=

# API
API_PORT=
WEB_ORIGIN=
LOG_LEVEL=info

# Web (Vite)
VITE_API_URL=

# LLM provider keys live server-side only (used by runtime-pi). Never expose to the browser.
# ANTHROPIC_API_KEY=
