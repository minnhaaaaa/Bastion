{
  "name": "bastion",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @bastion/db generate",
    "db:migrate": "pnpm --filter @bastion/db migrate",
    "workflow:validate": "pnpm --filter @bastion/api exec tsx src/cli/workflow.ts validate",
    "workflow:submit": "pnpm --filter @bastion/api exec tsx src/cli/workflow.ts submit",
    "workflow:project": "pnpm --filter @bastion/api exec tsx src/cli/workflow.ts project",
    "agent:login": "pnpm --filter @bastion/api exec tsx src/cli/agent.ts login",
    "agent:models": "pnpm --filter @bastion/api exec tsx src/cli/agent.ts models",
    "config:check": "pnpm --filter @bastion/api exec tsx src/cli/check-env.ts",
    "desktop:dev": "node apps/web/scripts/desktop.mjs dev",
    "desktop:build": "node apps/web/scripts/desktop.mjs build",
    "desktop:info": "node apps/web/scripts/desktop.mjs info"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
